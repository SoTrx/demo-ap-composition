AP_PROVENANCE_URL=http://ap-provenance:5000
APP_HOST=lig-kubdaisy.imag.fr

# Execute / Plan + Execute tabs. These tabs are disabled unless AP_EXECUTOR_EXECUTE_URL
# is set to a reachable executor's execute endpoint (full URL, gateway prefix and all):
# AP_EXECUTOR_EXECUTE_URL=http://datagems.127.0.0.1.sslip.io:8080/moma2/v1/api/aps/execute
# AP_EXECUTOR_SERVICE_URL only overrides the base URL that other executor calls derive from.
# AP_EXECUTOR_SERVICE_URL=http://ap-executor:5000

# SCAYLE LLM (this is behind the VPN)
SCAYLE_API_BASE=https://172.16.59.5:32443
SCAYLE_API_USER=YOUR_USERNAME
SCAYLE_API_PASSWORD=YOUR_PASSWORD

# Magic operator (optional). The planner emits this as the node name of an operator it
# generates for a step no catalogued AP covers; the executor slugifies it into the
# Consul service name it resolves ("Magic Operator" -> "magic-operator"), so it must
# match the deployed magic operator's service name.
# MAGIC_OPERATOR_NAME=Magic Operator
# Leave empty: pinning a version filters the Consul lookup on Service.Meta.version,
# which consul-k8s Service Sync cannot set.
# MAGIC_OPERATOR_VERSION=
